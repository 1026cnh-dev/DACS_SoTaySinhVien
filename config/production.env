# ==========================================================
# DACS - RENDER / SUPABASE PRODUCTION
# File này chỉ chứa cấu hình KHÔNG BÍ MẬT.
# Secret thật phải đặt trong Render -> Environment.
# Các biến Render luôn được ưu tiên hơn giá trị trong file này.
# ==========================================================
APP_ENV=production
COOKIE_SECURE=true
DACS_ACCESS_LOG=0
UPLOAD_DIR=/app/uploads
SUPABASE_STORAGE_BUCKET=uploads

# Render tự cung cấp PORT nên không đặt cố định ở đây.
# PORT=

# KHÔNG ghi các secret dưới đây vào file/GitHub.
# Hãy khai báo chúng trong Render Environment:
# DATABASE_URL=postgresql://...
# SESSION_SECRET=...
# ADMIN_USER=...
# ADMIN_PASSWORD=...
# GOOGLE_CLIENT_ID=...
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
