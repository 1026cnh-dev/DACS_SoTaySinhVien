# ==========================================================
# DACS - LOCAL DEVELOPMENT
# File này được chọn mặc định khi chạy trên máy cá nhân.
# Không cần sửa mã Go.
# ==========================================================
APP_ENV=local
PORT=8080
SQLITE_PATH=student_handbook.db
UPLOAD_DIR=uploads
COOKIE_SECURE=false
DACS_ACCESS_LOG=1

# Để trống DATABASE_URL => chương trình tự dùng SQLite local.
DATABASE_URL=

# Local có thể để SESSION_SECRET trống. Hệ thống tự sinh .session_secret.
SESSION_SECRET=

# Tài khoản admin local mặc định có thể dùng cấu hình hiện tại của hệ thống.
# Có thể khai báo nếu muốn thay đổi mà không sửa code.
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Google login - tùy chọn.
GOOGLE_CLIENT_ID=

# Supabase Storage để trống => upload lưu trong thư mục local uploads/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
